{
  "name": "mogu-mogu-panic",
  "version": "1.0.0",
  "private": true,
  "description": "MOGU MOGU PANIC - ハイパーカジュアルゲーム(Web + iOS/Capacitor)",
  "scripts": {
    "serve": "node scripts/serve.cjs",
    "test": "node scripts/test-audio.cjs && node scripts/test-render.cjs && node scripts/test-core-regressions.cjs && node scripts/test-storage.cjs",
    "test:browser": "node scripts/test-audio-browser.cjs",
    "capacitor:sync:after": "node scripts/normalize-ios-paths.cjs",
    "build:collab-preview": "node scripts/build-web.js --collab-preview",
    "build:web": "node scripts/build-web.js",
    "sync": "npm run sync:ios",
    "sync:ios": "node scripts/sync-ios.cjs",
    "sync:ios:collab": "node scripts/sync-ios.cjs --collab-preview",
    "sync:ios:normal": "node scripts/sync-ios.cjs --normal",
    "open:ios": "cap open ios",
    "icons": "capacitor-assets generate --ios --iconBackgroundColor #7ec8e3 --iconBackgroundColorDark #16323d"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.0",
    "@capacitor/browser": "^8.0.3",
    "@capacitor/core": "^8.4.1",
    "@capacitor/ios": "^8.4.1",
    "@capacitor/preferences": "^8.0.1"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.4.1"
  }
}
